FROM python:3.9-slim

WORKDIR /app

COPY requirements-newsletter.txt .
RUN pip install -r requirements-newsletter.txt

COPY newsletter_link_extractor_service.py .
COPY build_manifest.py .

# Build-time manifest: record checksums of all Python sources + git SHA
ARG GIT_SHA=unknown
RUN echo "${GIT_SHA}" > /app/.git_sha
RUN python build_manifest.py /app /app/.build_manifest.json

EXPOSE 5014

CMD ["python", "newsletter_link_extractor_service.py"]
