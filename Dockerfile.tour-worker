FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy every service module. tour_worker_service.py imports no siblings today,
# but copying only the entry point is the same trap that broke the other
# services (see note in Dockerfile.orchestrator): a future import would fail
# closed at runtime. Dockerfile.cloudrun copies *.py for exactly this reason.
COPY *.py .

# Create tours directory
RUN mkdir -p /app/tours

EXPOSE 5040

# Worker timeout should be set BELOW the Cloud Tasks dispatch deadline (900s)
# to prevent Cloud Tasks from retrying while worker is still finishing.
# Deploy with: --timeout=840
ENV PORT=5040
ENV PYTHONUNBUFFERED=1

CMD ["python", "tour_worker_service.py"]
