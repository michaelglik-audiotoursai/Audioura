FROM python:3.9-slim

WORKDIR /app

# Install ffmpeg for pydub
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

COPY requirements-news.txt .
RUN pip install --no-cache-dir -r requirements-news.txt

COPY news_processor_service.py .
COPY build_manifest.py .
# [LOCAL-708 / 708B / D670] Per-plan article length + the plan-aware truncation
# notice (names the plans, page lengths, "See plans") and the spoken audio notice.
COPY article_truncation.py .
COPY subscription_levels.py .

# Build-time manifest: record checksums of all Python sources + git SHA
ARG GIT_SHA=unknown
RUN echo "${GIT_SHA}" > /app/.git_sha
RUN python build_manifest.py /app /app/.build_manifest.json

EXPOSE 5011

CMD ["python", "news_processor_service.py"]
