FROM python:3.9-slim

WORKDIR /app

# cryptography: /submit_credentials decryption imports it lazily, so omitting it gives
# a container that starts cleanly and fails only at request time (ClickUp wdvrday52p).
RUN pip install flask psycopg2-binary requests beautifulsoup4 'cryptography>=41.0.0'

# newsletter_processor_service.py imports seven sibling modules (apple_podcasts_processor,
# spotify_processor, subscription_detector, dh_service_simple, user_consolidation_service,
# credential_verification_service, advertising_url_filter). Copying the service file alone
# crash-loops on ModuleNotFoundError. An explicit list drifts every time an import is added,
# which is how this broke — so copy them all, as Dockerfile.cloudrun already does.
# .dockerignore keeps tests and one-off scripts out of the context.
COPY *.py .

EXPOSE 5017

CMD ["python", "newsletter_processor_service.py"]