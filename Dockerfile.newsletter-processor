FROM python:3.9-slim

WORKDIR /app

RUN pip install flask psycopg2-binary requests beautifulsoup4

# Copy all modules — this entry point imports 13 sibling modules
# (apple_podcasts_processor, entitlements, content_expander, ...), none of
# which were copied. See note in Dockerfile.orchestrator.
COPY *.py .

EXPOSE 5017

CMD ["python", "newsletter_processor_service.py"]