FROM python:3.9-slim

WORKDIR /app

COPY requirements_generator.txt /app/requirements_generator.txt
RUN pip install --no-cache-dir -r requirements_generator.txt

COPY *.py /app/
COPY *.json /app/
COPY templates/ /app/templates/

ENV STORIED_MODE=true
ENV PYTHONUNBUFFERED=1

EXPOSE 5000

CMD ["python", "generate_tour_text_service.py"]
