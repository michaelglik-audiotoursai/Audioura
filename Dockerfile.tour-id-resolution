FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-tour-id-resolution.txt .
RUN pip install --no-cache-dir -r requirements-tour-id-resolution.txt

# Copy service file
COPY deeplink_resolution_endpoint.py storied_version_constants.py tour_id_resolution_service.py tour_sharing.py build_manifest.py ./

# Create tours directory
RUN mkdir -p /app/tours

# Build-time manifest: record checksums of all Python sources + git SHA
ARG GIT_SHA=unknown
RUN echo "${GIT_SHA}" > /app/.git_sha
RUN python build_manifest.py /app /app/.build_manifest.json

EXPOSE 5025

CMD ["python", "tour_id_resolution_service.py"]
