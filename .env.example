# =============================================================================
# Audioura Services - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in actual values.
# .env is gitignored and MUST NOT be committed.
# =============================================================================

# --- Database ---
DB_HOST=postgres-2
DB_NAME=audiotours
DB_USER=admin
DB_PASSWORD=<SET_THIS>
DB_PORT=5432

# --- AWS (Polly TTS + Comprehend) ---
AWS_ACCESS_KEY_ID=<SET_THIS>
AWS_SECRET_ACCESS_KEY=<SET_THIS>
AWS_DEFAULT_REGION=us-east-1

# --- OpenAI ---
OPENAI_API_KEY=<SET_THIS>

# --- Cloudflare R2 (Phase D - blob storage) ---
R2_ACCESS_KEY_ID=<SET_THIS>
R2_SECRET_ACCESS_KEY=<SET_THIS>
R2_ENDPOINT=https://4b4aa47cda0cc65f20b20ac0b363ac7.r2.cloudflarestorage.com
R2_BUCKET=v1-audiotours-r2-bucket

# --- Feature Flags ---
# TOUR_STORAGE_MODE: 'volume' (local Docker, default) or 'cloud' (Cloud Run)
TOUR_STORAGE_MODE=volume
# BLOB_STORAGE_TYPE: 'database' (default) or 'r2' (Phase D)
BLOB_STORAGE_TYPE=database

# --- Inter-Service URLs (defaults work in Docker Compose - override for Cloud Run) ---
# TOUR_GENERATOR_URL=http://development-tour-generator-1:5000
# MODERNIZED_URL=http://tour-generation-modernized-1:5021
# TRANSLATION_URL=http://translation-service-1:5030
# TOUR_UPDATE_URL=http://development-tour-update-1:5001
# USER_API_URL=http://user-api-2:5000
# COORDINATES_URL=http://coordinates-fromai:5004
# POLLY_TTS_URL=http://polly-tts-1:5018
# NEWS_GENERATOR_URL=http://news-generator-1:5010
# NEWS_PROCESSOR_URL=http://news-processor-1:5011
# NEWS_ORCHESTRATOR_URL=http://news-orchestrator-1:5012
# VOICE_CONTROL_URL=http://development-voice-control-1:5008
