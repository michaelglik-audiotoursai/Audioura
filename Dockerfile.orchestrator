FROM python:3.9-slim
WORKDIR /app
COPY requirements_orchestrator.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY tour_orchestrator_service.py /app/
COPY entitlements.py /app/
COPY cost_ceiling_monitor.py /app/
COPY wallet_api.py /app/
COPY wallet_ledger.py /app/
COPY pricing.py /app/
COPY cost_meter.py /app/
COPY cost_rates.py /app/
COPY build_manifest.py /app/

# Build-time manifest: record checksums of all Python sources + git SHA
ARG GIT_SHA=unknown
RUN echo "${GIT_SHA}" > /app/.git_sha
RUN python build_manifest.py /app /app/.build_manifest.json

EXPOSE 5002
CMD ["python", "tour_orchestrator_service.py"]
