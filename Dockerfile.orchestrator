FROM python:3.9-slim
# [D635] network-level paid-API meter in every process (sitecustomize)
COPY _meter/ /opt/meter/
ENV PYTHONPATH=/opt/meter
WORKDIR /app
COPY requirements_orchestrator.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY tour_orchestrator_service.py /app/
COPY swipe_preference_service.py /app/
COPY tests/db_connection.py /app/tests/db_connection.py
COPY entitlements.py /app/
COPY subscription_levels.py /app/
COPY l2_seats.py /app/
COPY l2_seat_job.py /app/
COPY cost_ceiling_monitor.py /app/
COPY wallet_api.py /app/
COPY tier_change.py /app/
COPY payment_provider.py /app/
COPY fake_payment_provider.py /app/
COPY wallet_ledger.py /app/
COPY pricing.py /app/
COPY cost_meter.py /app/
COPY cost_rates.py /app/
COPY build_manifest.py /app/
# Every local module tour_orchestrator_service.py imports (LEAD 2026-10-04: user_stops_flag was
# missing, so any rebuild crash-looped; the others degraded silently).
COPY quality_guardrails.py /app/
COPY swipe_preference_service.py /app/
COPY tour_rating_service.py /app/
COPY tour_reviews_service.py /app/
COPY tour_pricing_service.py /app/
COPY recovery_code_service.py /app/
COPY community_tours_service.py /app/
# [GCS-C1, LEAD] Nominatim geocoder used by the coordinate fallback; without it the import fails open and the free lookup never runs.
COPY geocode_stops.py /app/
COPY price_tiers.py /app/
COPY tour_scoring_service.py /app/
# [LOCAL-602] tour_scoring_service imports tour_evaluator, which imports
# tour_rubric_scorer; both were missing, so the orchestrator logged
# "[SCORING] Non-fatal error: No module named 'tour_evaluator'" and skipped all
# scoring. tour_scoring_service also reads tour_rubric_scorer.py's source at
# runtime (_get_code_sha), so the file itself must be present, not just importable.
COPY tour_evaluator.py /app/
COPY tour_rubric_scorer.py /app/
COPY user_quality_index.py /app/
COPY user_stops_flag.py /app/
# [LOCAL-711 / D673] Written at creation after an original tour succeeds
# (make_short_title_only, non-blocking). Self-contained (no llm_models import),
# so this one COPY line is all the orchestrator image needs.
COPY tour_short_title.py /app/
# [LOCAL-724B defect 1] store_audio_tour does `import tour_content_rating` in the
# serving path to rate a new/edited ORIGINAL before it can list (LOCAL-724 items
# 1, 2 & 4). This Dockerfile COPYies sources one-by-one, and the rater was NOT in
# the list, so in the built image the import raised, the except printed, and the
# tour committed UNRATED (NULL) — listed as General. LOCAL-724's live proof
# imported the module on the HOST, never from the image, so it could not see
# this. Copy it so `python -c "import tour_content_rating"` works in-container.
COPY tour_content_rating.py /app/

# [LOCAL-766 / D713] store_audio_tour records stop-pool PROVENANCE after the
# audio_tours row is INSERTed (which pooled stops this tour delivered), so the
# delivery rule can later skip a priced/community tour's pooled stops for a
# non-creator. `_record_pool_provenance` does `import stop_pool_sources`, which in
# turn `import stop_pool_store` to reproduce the pool's own (pool_key, title_norm)
# keying. This Dockerfile COPYies sources one-by-one, so BOTH modules must be
# present or the import raises and provenance is silently never recorded (the
# LOCAL-724B lesson: the host import hid a missing in-image module). stop_pool_
# store falls back to an internal shim when tour_cache_layer1 is absent, so these
# two files are all the orchestrator image needs.
COPY stop_pool_sources.py /app/
COPY stop_pool_store.py /app/

# Build-time manifest: record checksums of all Python sources + git SHA
ARG GIT_SHA=unknown
RUN echo "${GIT_SHA}" > /app/.git_sha
RUN python build_manifest.py /app /app/.build_manifest.json

EXPOSE 5002
CMD ["python", "tour_orchestrator_service.py"]
