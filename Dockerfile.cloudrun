# Audioura Cloud Run Service Image
# Contains all Python service files. CMD selects which service to run.
# Build once, deploy many (different CMD per Cloud Run service).
FROM python:3.11-slim

# Release identity, baked in at build time by the deploy scripts.
# WITHOUT these ARG lines the --build-arg values are SILENTLY DISCARDED and the
# image carries no version at all -- the failure mode is a no-op that looks fine.
# RELEASE_TAG is v<line>t<seq>, e.g. v2t357: line 1=beta 2=storied 3=subscribed,
# permanent per release line so a promoted build keeps the number it shipped with.
# The tag is pushed to origin, so `git checkout $RELEASE_TAG` reconstitutes exactly
# what is running. See release_tag.sh.
ARG RELEASE_TAG="unset"
ARG GIT_SHA="unset"
# BUILD_NUMBER is the DISPLAY number the app shows next to Stable/Preview
# (git rev-list --count HEAD). GIT_BRANCH records which line the image came from.
# All three are baked in at build time by the deploy scripts. WITHOUT these ARG
# lines the --build-arg values are SILENTLY DISCARDED. A build made without them
# degrades to the declared defaults below -- a CLEAR sentinel, never a stale or
# wrong number (a wrong build_number mislabels which engine produced a tour).
ARG BUILD_NUMBER="unknown"
ARG GIT_BRANCH="unknown"
ENV RELEASE_TAG=${RELEASE_TAG} \
    GIT_SHA=${GIT_SHA} \
    BUILD_NUMBER=${BUILD_NUMBER} \
    GIT_BRANCH=${GIT_BRANCH}


WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies (superset covering all services)
# cryptography is NOT optional: dh_service_simple.decrypt_credentials_with_mobile_key
# imports it INSIDE the function, so a container without it boots, passes health
# checks, and then returns 400 "Decryption failed: No module named 'cryptography'"
# on every /submit_credentials call. requirements.txt has declared it all along,
# but this Dockerfile installs a hand-maintained list and never reads that file,
# so the declaration bought nothing. ClickUp wdvrday52p.
RUN pip install --no-cache-dir \
    flask==2.3.3 \
    flask-cors==4.0.0 \
    requests==2.31.0 \
    psycopg2-binary==2.9.9 \
    boto3>=1.34.0 \
    openai>=1.3.0 \
    cryptography>=41.0.0 \
    beautifulsoup4==4.12.2 \
    pydub==0.25.1 \
    python-dotenv \
    lxml==4.9.3

# Copy all service files
COPY *.py /app/

# Build-time manifest: record checksums of all Python sources + git identity.
# The .git directory is NOT in this build context (COPY *.py only), so
# `git rev-parse` inside the container cannot work -- the values MUST arrive as
# build args. We write them to files that build_manifest.py reads, then generate
# /app/.build_manifest.json which manifest_check.py serves on /health.
# Omitting the build args leaves the ARG defaults ("unknown"), so a mis-built
# image reports a clear sentinel instead of a stale/wrong number.
RUN echo "${GIT_SHA}" > /app/.git_sha \
    && echo "${BUILD_NUMBER}" > /app/.build_number \
    && echo "${GIT_BRANCH}" > /app/.git_branch \
    && python build_manifest.py /app /app/.build_manifest.json

# Create tours directory (for volume mode compatibility)
RUN mkdir -p /app/tours

EXPOSE 8080

# Default health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/health || exit 1
